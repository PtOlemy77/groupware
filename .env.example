# Set before running docker compose; never commit real credentials.
DB_PASSWORD=replace-with-a-long-random-password
DB_USER=nexus
DB_URL=jdbc:postgresql://localhost:5433/groupware_db
# Bootstrap only when the employees table is empty; existing accounts are never changed.
BOOTSTRAP_ADMIN_EMAIL=admin@spatialt.co.kr
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Vite dev/preview proxy target. Static production hosting must configure its own /api reverse proxy.
API_INTERNAL_URL=http://127.0.0.1:8080
# Production uses the prod Spring profile and HTTPS; secure cookies are then mandatory.
COOKIE_SECURE=false

# Both official G2B APIs must be approved for this decoded service key.
# Keep this key on the backend; never use a VITE_ variable or commit a real key.
G2B_SERVICE_KEY=
G2B_ENABLED=true
# Hourly: institution searches over at least 7 days, all pages (999 rows/page). Tune to granted quota.
G2B_INTERVAL_MS=3600000
G2B_BUSINESS_TYPES=SERVC,THNG,CNSTWK,FRGCPT
